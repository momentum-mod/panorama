<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/pages/leaderboards/leaderboards.ts" />
	</scripts>

	<Leaderboards class="leaderboards leaderboards__list" acceptsinput="true" acceptsfocus="true" hittest="true" hittestchildren="true">
		<Panel class="leaderboard-top">
			<Panel class="leaderboard-radio">
				<RadioButton id="TimesListGlobal" class="leaderboard-radio__radio-button" onactivate="LeaderboardsHandler.setFilter(LeaderboardRecordsFilter.GLOBAL)">
					<Label class="leaderboard-radio__radio-button__label" text="#Leaderboards_Category_Global" />
				</RadioButton>
				<RadioButton id="TimesListFriends" class="leaderboard-radio__radio-button" onactivate="LeaderboardsHandler.setFilter(LeaderboardRecordsFilter.FRIENDS)">
					<Label class="leaderboard-radio__radio-button__label" text="#Leaderboards_Category_Friends" />
				</RadioButton>
				<RadioButton id="TimesListLobby" class="leaderboard-radio__radio-button" onactivate="LeaderboardsHandler.setFilter(LeaderboardRecordsFilter.LOBBY)">
					<Label class="leaderboard-radio__radio-button__label" text="#Leaderboards_Category_Lobby" />
				</RadioButton>
				<RadioButton id="TimesListLocal" class="leaderboard-radio__radio-button leaderboard-radio__radio-button--saved" onactivate="LeaderboardsHandler.setFilter(LeaderboardRecordsFilter.SAVED_REPLAYS)">
					<Label class="leaderboard-radio__radio-button__label" text="Saved Replays" />
				</RadioButton>
			</Panel>
		</Panel>
		<Panel class="leaderboard-center">
			<Panel id="LeaderboardTimesContainer" class="leaderboard-times">
                <Panel id="TimesList2" class="leaderboard-times__list">
                    <!-- Populated via code -->
                </Panel>

                <Panel id="GroupPillsLayer" class="leaderboard-times__group-pills" hittest="false" hittestchildren="false">
                    <!-- Populated via code -->
                </Panel>

				<Panel class="leaderboard-times__empty">
					<Panel class="v-align-center h-align-center flow-down">
						<Label id="LeaderboardEmptyWarningTitle" class="text-h3 h-align-center mb-3" text="#Leaderboards_NoRunsFound" />
						<Label id="LeaderboardEmptyWarningText" class="h-align-center" text="{s:empty-warning}" />
					</Panel>
				</Panel>
				<Panel class="leaderboard-times__loading">
					<Panel class="v-align-center h-align-center flow-down">
						<Image class="button__icon button__icon--left spin-clockwise leaderboard-times__loading-spinner" src="file://{images}/refresh.svg" textureheight="128" />
						<Label class="text-h5 h-align-center" text="#Leaderboards_RequestingData" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>

		<Panel class="leaderboard-bottom">
            <Panel id="LeaderboardTools" class="leaderboard-tools">
                <TooltipPanel class="leaderboard-tools__tooltip" tooltip="#HudCustomizer_Menu">
                    <Button id="CustomizerOpen" class="leaderboard-tools__button" onactivate="LeaderboardsHandler.openHudCustomizer()">
                        <Panel class="leaderboard-tools__icon-container">
                            <Image class="leaderboard-tools__icon" src="file://{images}/vector-two-click.svg" textureheight="24" />
                        </Panel>
                    </Button>
                </TooltipPanel>

                <ConVarEnabler class="leaderboard-tools__cheat-gate" convar="sv_cheats" togglevisibility="true">
                    <TooltipPanel class="leaderboard-tools__tooltip" tooltip="#Zoning_Menu">
                        <Button id="ZoningOpen" class="leaderboard-tools__button" onactivate="LeaderboardsHandler.openZoneEditor()">
                            <Panel class="leaderboard-tools__icon-container">
                                <Image class="leaderboard-tools__icon" src="file://{images}/timer-edit.svg" textureheight="24" />
                            </Panel>
                        </Button>
                    </TooltipPanel>
                </ConVarEnabler>
            </Panel>

            <Panel id="ControlsContainer" class="leaderboard-controls">
                <Button id="GroupPrev" class="leaderboard-controls__change-page leaderboard-controls__change-page--group" onactivate="LeaderboardsHandler.previousGroup()">
                    <Image textureheight="24" src="file://{images}/double-chevron-left.svg" />
                </Button>

                <Button id="PagePrev" class="leaderboard-controls__change-page" onactivate="LeaderboardsHandler.previousPage()">
                    <Image textureheight="24" src="file://{images}/chevron-left.svg" />
                </Button>

                <TextEntry id="PageSelect" class="leaderboard-controls__select-page" textmode="numeric" text="1" />
                <Label id="TotalPages" class="leaderboard-controls__total-pages" text="/ {i:total-pages}"/>

                <Button id="PageNext" class="leaderboard-controls__change-page" onactivate="LeaderboardsHandler.nextPage()">
                    <Image textureheight="24" src="file://{images}/chevron-right.svg" />
                </Button>

                <Button id="GroupNext" class="leaderboard-controls__change-page leaderboard-controls__change-page--group" onactivate="LeaderboardsHandler.nextGroup()">
                    <Image textureheight="24" src="file://{images}/double-chevron-right.svg" />
                </Button>
            </Panel>

            <TooltipPanel class="leaderboard-around" tooltip="#Leaderboards_PersonalBestTooltip">
                <Button id="Around" class="leaderboard-around__button" onactivate="LeaderboardsHandler.showAroundPage()">
                    <Panel class="leaderboard-around__icon-container">
                        <Image id="Icon" class="leaderboard-around__icon" src="file://{images}/jump-to.svg" textureheight="24" />
                    </Panel>
                </Button>
            </TooltipPanel>
		</Panel>
	</Leaderboards>
</root>