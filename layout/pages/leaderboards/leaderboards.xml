<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/pages/leaderboards/leaderboards.ts" />
	</scripts>

	<Leaderboards class="leaderboards leaderboards__list" acceptsinput="true" acceptsfocus="true" hittest="true" hittestchildren="true">
		<Panel class="leaderboard-top">
			<Panel class="leaderboard-radio">
				<RadioButton id="TimesListGlobal" class="leaderboard-radio__radio-button" >
					<Label class="leaderboard-radio__radio-button__label" text="#Leaderboards_Category_Global" />
				</RadioButton>
				<RadioButton id="TimesListFriends" class="leaderboard-radio__radio-button" >
					<Label class="leaderboard-radio__radio-button__label" text="#Leaderboards_Category_Friends" />
				</RadioButton>
				<RadioButton id="TimesListLobby" class="leaderboard-radio__radio-button" onmouseout="UiToolkitAPI.HideTextTooltip();">
					<Label class="leaderboard-radio__radio-button__label" text="#Leaderboards_Category_Lobby" />
				</RadioButton>
				<RadioButton id="TimesListLocal" class="leaderboard-radio__radio-button leaderboard-radio__radio-button--saved" >
					<Label class="leaderboard-radio__radio-button__label" text="Saved Replays" />
				</RadioButton>
			</Panel>
		</Panel>
		<Panel class="leaderboard-center">
			<Panel id="LeaderboardTimesContainer" class="leaderboard-times">
				<DelayLoadList id="TimesList" class="leaderboard-times__list" itemheight="35px" itemwidth="100%" spacersize="0px" spacerperiod="1">
					<!-- Populated via code -->
				</DelayLoadList>
				<Panel class="leaderboard-times__empty">
					<Panel class="v-align-center h-align-center flow-down">
						<Label id="LeaderboardEmptyWarningTitle" class="text-h3 h-align-center mb-3" text="#Leaderboards_NoRunsFound" />
						<Label id="LeaderboardEmptyWarningText" class="h-align-center" text="{s:empty-warning}" />
					</Panel>
				</Panel>
				<Panel class="leaderboard-times__loading">
					<Panel class="v-align-center h-align-center flow-down">
						<Image class="button__icon button__icon--left spin-clockwise leaderboard-times__loading-spinner" src="file://{images}/refresh.svg" textureheight="128" />
						<Label class="text-h5 h-align-center" text="#Leaderboards_RequestingData" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>

		<Panel class="leaderboard-bottom">
            <Panel id="ControlsContainer" class="leaderboard-controls">
                <Panel class="leaderboard-controls__change-page leaderboard-controls__change-page--group" onactivate="LeaderboardsHandler.previousGroup()">
                    <Image id="GroupPrev" textureheight="24" src="file://{images}/double-chevron-left.svg" />
                </Panel>

                <Button class="leaderboard-controls__change-page" onactivate="LeaderboardsHandler.previousPage()">
                    <Image id="PagePrev" textureheight="24" src="file://{images}/chevron-left.svg" />
                </Button>

                <TextEntry id="PageSelect" class="leaderboard-controls__select-page" textmode="numeric" text="1" />
                <Label id="TotalPages" class="leaderboard-controls__total-pages" text="/ {i:total-pages}"/>

                <Button class="leaderboard-controls__change-page" onactivate="LeaderboardsHandler.nextPage()">
                    <Image id="PageNext" textureheight="24" src="file://{images}/chevron-right.svg" />
                </Button>

                <Button class="leaderboard-controls__change-page leaderboard-controls__change-page--group" onactivate="LeaderboardsHandler.nextGroup()">
                    <Image id="GroupNext" textureheight="24" src="file://{images}/double-chevron-right.svg" />
                </Button>
            </Panel>
		</Panel>


		<!-- REQUIRED BY C++ -->

		<DropDown id="StylesDropdown" class="dropdown leaderboards__style-dropdown hide" menuclass="dropdown-menu">
				<Panel id="placeholder" /> <!-- This is needed to dynamically add dropdown items from code -->
		</DropDown>

		
		<Panel id="FilterButtonsSubtype" class="leaderboard-filter-buttons__subtypes">
			<Panel class="leaderboard-filter-buttons__local tabs hide">
				<RadioButton id="LocalTypeRuns" class="tabs__tab hide">
					<Label class="tabs__text" text="#Leaderboards_Category_YourRuns" />
				</RadioButton>
				<RadioButton id="LocalTypeDownloaded" class="tabs__tab hide">
					<Label class="tabs__text" text="#Leaderboards_Category_Downloaded" />
				</RadioButton>
			</Panel>

			<!-- What the actual fuck is going on here. Something is specifically requring one of these buttons to be selected to load leaderboards.
			It's not enough that the function .setSelectedListType runs, the button NEEDS to be selected or leaderboards won't load -->
			<Panel class="leaderboard-filter-buttons__online tabs w-full h-full">
				<RadioButton id="OnlineTypeTop10" class="tabs__tab">
					<Label class="tabs__text" text="#Leaderboards_Category_Top10" />
				</RadioButton>
				<RadioButton id="OnlineTypeAround" class="tabs__tab">
					<Label class="tabs__text" text="#Leaderboards_Category_Around" />
				</RadioButton>
				<RadioButton id="OnlineTypeFriends" class="tabs__tab">
					<Label class="tabs__text" text="#Leaderboards_Category_Friends" />
				</RadioButton>
			</Panel>
		</Panel>



	</Leaderboards>
</root>