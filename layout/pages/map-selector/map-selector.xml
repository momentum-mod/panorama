<!--						</Panel>-->

						<Panel id="CategoryContents" class="mapselector__category-contents">
							<Panel id="MapSelector" class="mapselector__maps">
								<Panel class="mapselector__maps-topsection">
									<Panel class="mapselector-gamemodes">
										<RadioButton id="SurfFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button" selected="true">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_Surf" />
										</RadioButton>
										<RadioButton id="BhopFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_Bhop" />
										</RadioButton>
										<RadioButton id="BhopHL1FilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_BhopHL1" />
										</RadioButton>
										<RadioButton id="KzMomFilterButton" class="hide button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_KzMom" />
										</RadioButton>
										<RadioButton id="KzKztFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_KzKzt" />
										</RadioButton>
										<RadioButton id="Kz16FilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_Kz16" />
										</RadioButton>
										<RadioButton id="RJFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_RJ" />
										</RadioButton>
										<RadioButton id="SJFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_SJ" />
										</RadioButton>
										<RadioButton id="AhopFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_Ahop" />
										</RadioButton>
										<RadioButton id="ConcFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_Conc" />
										</RadioButton>
										<RadioButton id="DefragCPMFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_DefragCPM" />
										</RadioButton>
										<RadioButton id="DefragVQ3FilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_DefragVQ3" />
										</RadioButton>
										<RadioButton id="DefragVTGFilterButton" class="button radiobutton radiobutton--blue mapselector-gamemodes__gamemode-button">
											<Label class="button__text mapselector-gamemodes__text" text="#Gamemode_DefragVTG" />
										</RadioButton>
									</Panel>
									<Panel id="MapSelectorFeatured">
										<Button id="MapSelectorFeaturedToggle" onactivate="$('#MapSelectorFeatured').ToggleClass('collapsed')">
											<Label class="mapselector-featuredtoggle__label" text="#MapSelector_FeaturedMapLobbies" />
											<Panel class="mapselector-featuredtoggle__expandicon"></Panel>
											<Panel class="mapselector-featuredtoggle__totalplayers">
												<Image class="mapselector-featuredtoggle__totalplayers-icon" src="file://{images}/profile.svg" textureheight="40" />
												<Label id="MapSelectorFeaturedTotalPlayers" class="mapselector-featuredtoggle__totalplayers-playercount" text="0" />
											</Panel>
										</Button>

										<Panel id="MapSelectorFeaturedList">
										</Panel>

										<Panel id="MapSelectorFeaturedUpdateTickerGroup">
											<Image class="mapselector-featuredticker_icon" src="file://{images}/clock.svg" textureheight="20" />
											<Label id="MapSelectorFeaturedUpdateTicker" text="00:00" />
										</Panel>
									</Panel>
									<Panel class="mapselector-header">
										<Panel class="tabs mapselector-header__tabs">
											<TooltipPanel class="mapselector-header__tab-tooltip" tooltip="#MapSelector_Tabs_Ranked_Tooltip">
												<RadioButton id="MapListRanked" class="tabs__tab mapselector-header__tab" group="MapListNavBar" selected="true">
													<Label class="tabs__text" text="#MapSelector_Tabs_Ranked" />
												</RadioButton>
											</TooltipPanel>
											<Panel class="tabs__gap" />
											<TooltipPanel class="mapselector-header__tab-tooltip" tooltip="#MapSelector_Tabs_Unranked_Tooltip">
												<RadioButton id="MapListUnranked" class="tabs__tab mapselector-header__tab" group="MapListNavBar">
													<Label class="tabs__text" text="#MapSelector_Tabs_Unranked" />
												</RadioButton>
											</TooltipPanel>
											<Panel class="tabs__gap" />
											<TooltipPanel class="mapselector-header__tab-tooltip" tooltip="#MapSelector_Tabs_Beta_Tooltip">
												<RadioButton id="MapListBeta" class="tabs__tab mapselector-header__tab" group="MapListNavBar">
													<Label class="tabs__text" text="#MapSelector_Tabs_Beta" />
												</RadioButton>
											</TooltipPanel>
										</Panel>
										<Panel class="mapselector-header__tryme">
											<Panel class="mapselector-header__tryme__middle">
												<Label class="mapselector-header__tryme__inner" text="#Common_TryMe" />
											</Panel>
										</Panel>
										<Panel class="search mapselector-header__search">
											<Image class="search__icon" src="file://{images}/search.svg" textureheight="32" />
											<TextEntry id="MapSearchTextEntry" class="search__textentry" maxchars="30" placeholder="#MapSelector_SearchMaps" />
											<Button id="MapSearchClear" class="search__clearbutton search__clearbutton--hidden" onactivate="MapSelectorHandler.clearSearch()">
												<Image class="search__clearicon" src="file://{images}/close.svg" textureheight="32" />
											</Button>
										</Panel>
										<TooltipPanel class="mr-2" tooltip="#MapSelector_Updates_Check">
											<Button class="button" onactivate="MapSelectorHandler.checkForUpdates()">
												<Image id="RefreshIcon" class="button__icon" src="file://{images}/refresh.svg" textureheight="32" />
											</Button>
										</TooltipPanel>
										<TooltipPanel tooltip="#MapSelector_Filters_Reset">
											<Button class="button button--red" onactivate="MapSelectorHandler.clearFilters()">
												<Image class="button__icon" src="file://{images}/filter-remove.svg" textureheight="32" />
											</Button>
										</TooltipPanel>
									</Panel>
									<Panel id="MapFilters" class="mapselector-filters">
										<Panel class="mapselector-filters__row">
											<Panel class="mapselector-filters__tiers">
												<Label class="mapselector-filters__tier-label" text="#MapSelector_Filters_Tier" />
												<Panel class="mapselector-tier-slider">
													<Panel class="mapselector-tier-slider__numbers">
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--1" text="1" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--2" text="2" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--3" text="3" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--4" text="4" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--5" text="5" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--6" text="6" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--7" text="7" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--8" text="8" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--9" text="9" />
														<Panel class="mapselector-tier-slider__gap" />
														<Label class="mapselector-tier-slider__number mapselector-tier-slider__number--10" text="10" />
													</Panel>
													<DualSlider id="TierSlider" class="slider slider--horizontal mapselector-tier-slider__slider" snaptoincrement="true" direction="horizontal" min="1" max="10" increment="1" default="1" default2="10" value="1" value2="10" />
												</Panel>
											</Panel>
											<Panel class="flow-right h-align-right v-align-bottom">
												<TooltipPanel tooltip="#MapSelector_Filters_ByCompleted">
													<NStateButton id="MapCompletedFilterButton" class="button nstatebutton mapselector-filters__nstatebutton mr-2">
														<Image class="button__icon" src="file://{images}/flag.svg" textureheight="32" />
													</NStateButton>
												</TooltipPanel>
												<TooltipPanel tooltip="#MapSelector_Filters_ByFavorited">
													<NStateButton id="MapFavoritedFilterButton" class="button nstatebutton mapselector-filters__nstatebutton mr-2">
														<Image class="button__icon" src="file://{images}/star.svg" textureheight="32" />
													</NStateButton>
												</TooltipPanel>
												<TooltipPanel tooltip="#MapSelector_Filters_ByDownloaded">
													<NStateButton id="MapDownloadedFilterButton" class="button nstatebutton mapselector-filters__nstatebutton mr-2">
														<Image class="button__icon" src="file://{images}/download.svg" textureheight="32" />
													</NStateButton>
												</TooltipPanel>
												<DropDown id="SortByDropdown" class="dropdown sorting__dropdown" menuclass="dropdown-menu">
													<Label text="#MapSelector_Sorting_DateReleased_Asc" id="dateRelAsc" value="6" />
													<Label text="#MapSelector_Sorting_DateReleased_Desc" id="dateRelDesc" value="7" />
													<Label text="#MapSelector_Sorting_Alphabetical_Asc" id="alphaAsc" value="0" />
													<Label text="#MapSelector_Sorting_Alphabetical_Desc" id="alphaDesc" value="1" />
													<Label text="#MapSelector_Sorting_Tier_Asc" id="tierAsc" value="2" />
													<Label text="#MapSelector_Sorting_Tier_Desc" id="tierDesc" value="3" />
													<Label text="#MapSelector_Sorting_LastPlayed_Asc" id="lastPlayAsc" value="4" />
													<Label text="#MapSelector_Sorting_LastPlayed_Desc" id="lastPlayDesc" value="5" />
													<Label text="#MapSelector_Sorting_DateCreated_Asc" id="dateCreatedAsc" value="8" />
													<Label text="#MapSelector_Sorting_DateCreated_Desc" id="dateCreatedDesc" value="9" />
												</DropDown>
											</Panel>
										</Panel>
									</Panel>
								</Panel>

								<Panel class="mapselector__maps-bottomsection h-fill">
									<DelayLoadList id="MapListContainer" class="mapselector__list" itemheight="54px" itemwidth="100%" spacersize="3px" spacerperiod="1">
										<!-- Populated via MapEntry snippets in code -->
									</DelayLoadList>
									<Panel id="MapListEmptyContainer" class="mapselector__emptywarning mapselector__emptywarning--hidden">
										<Label class="text-h2 h-align-center mb-4" text="#MapSelector_Error_NoMapsFound" />
										<Label class="h-align-center text-align-center h-full" text="#MapSelector_Error_NoMapsFound_Long" />
									</Panel>
								</Panel>
							</Panel>

							<!-- Playlist Selector -->
							<Panel id="PlaylistSelector" class="mapselector__playlists">
								<Panel class="h-full w-full">
									<Label class="text-h1 text-align-center h-align-center mt-5" text="#Common_ComingSoon" />
								</Panel>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel class="mapselector__right">
                <Panel class="mapselector__right-top">
                    <MapInfo id="MapInfo" />
                </Panel>
                <Panel class="mapselector__right-center">
                    <Panel class="mapselector__track-selector-container">
                        <TrackSelector id="TrackSelector" />
                        <!-- <NewLeaderboards id="NewLeaderboards" /> -->
                    </Panel>
                </Panel>
                <Panel class="mapselector__right-bottom">
                    <Panel class="mapselector__right-bottom-spacer" />
                    <Button id="MapInfoWebsiteButton" class="button mapselector__right-bottom-website mr-1" onactivate="MapSelectorHandler.openInSteamOverlay();">
                        <Panel class="flow-right v-align-center h-align-center">
                            <Image class="button__icon mapselector__right-bottom-website__icon" src="file://{images}/globe.svg" textureheight="40" />
                            <Label class="button__text mapselector__right-bottom-website__text" text="#MapSelector_Button_Webpage" />
                        </Panel>
                    </Button>
                    <ToggleButton id="MapInfoFavorite" class="button togglebutton togglebutton--yellow mapselector__right-bottom-favorite mr-1">
                        <Panel class="flow-right v-align-center h-align-center">
                            <Image class="button__icon button__icon--left mapselector__right-bottom-favorite__icon" src="file://{images}/star.svg" textureheight="40" />
                            <Label class="button__text button__text--right mapselector__right-bottom-favorite__text" text="#MapSelector_Button_Favorite" />
                        </Panel>
                    </ToggleButton>
                    <Panel class="mapselector__right-bottom-action">
                        <Button id="MapInfoAction" class="button mapselector-action-button" onactivate="MapSelectorHandler.onActionButtonPressed();">
                            <Panel class="mapselector-action-button__typecontainer action-play">
                                <Image class="button__icon mapselector-action-button__icon" src="file://{images}/play-circle.svg" textureheight="40" />
                                <Label class="button__text mapselector-action-button__text" text="#MapSelector_Button_Play" />
                            </Panel>
                            <Panel class="mapselector-action-button__typecontainer action-download">
                                <Image class="button__icon mapselector-action-button__icon" src="file://{images}/download.svg" textureheight="40" />
                                <Label class="button__text mapselector-action-button__text" text="#MapSelector_Button_Download" />
                            </Panel>
                        </Button>
                        <MapDownloadStatus id="MapInfoDownloadStatus" class="map-download-status" />
                    </Panel>
                </Panel>
			</Panel>
		</Panel>










        <!-- ALL OF THIS NEEDS TO LIVE HERE OR THE GAME CRASHES.-->
        <Panel id="MapTimes" class="mapselector-leaderboards hide">
                <Leaderboards id="Leaderboards" class="mapselector-leaderboards__list mapselector-leaderboards__list-FUCK XML-hidden leaderboards-FUCK XML-in-map-selector" />
        </Panel>
        <Panel id="MapInfoStats" class="mapselector-stats hide" />
	</MomentumMapSelect>
</root>
