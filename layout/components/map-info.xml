<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	
	<scripts>
		<include type="module" src="file://{scripts}/components/map-info.ts" />
	</scripts>

    <MapInfo class="h-full w-full">
        <Panel id="MapInfoContainer" class="map-info-container ml-2 v-align-center" acceptsinput="true">
            <Panel>
                <!-- Stacked labels to give double layers of shadow. I don't like it, but I'll have to go along with it. -->
                <Label class="text-h1 text-shadow-outline ml-2" text="{s:name}" />
                <Label class="text-h1 text-shadow-black color-transparent ml-2" text="{s:name}" />
            </Panel>
            <Panel class="flow-right ml-2">
                <Label class="text-h4 text-shadow-outline" text="#MapInfo_Tier" />
                <Label id="HudTabMenuLinearSeparator" class="text-h4 text-shadow-outline" text="|" />
                <Label id="HudTabMenuLinearLabel" class="text-h4 text-shadow-outline" text="#MapInfo_Type_Linear" />
                <Label id="HudTabMenuStageCountSeparator" class="text-h4 text-shadow-outline" text="|" />
                <Label id="HudTabMenuStageCountLabel" class="text-h4 text-shadow-outline" text="#MapInfo_StageCount" />
                <Label id="HudTabMenuBonusCountSeparator" class="text-h4 text-shadow-outline" text="|" />
                <Label id="HudTabMenuBonusCountLabel" class="text-h4 text-shadow-outline" text="#MapInfo_BonusCount" />
                <Label id="HudTabMenuBonusesCountLabel" class="text-h4 text-shadow-outline" text="#MapInfo_BonusesCount" />
                <Panel id="RequiredGames" class="v-align-center flow-right ml-4">
                    <Panel id="CSS" class="map-info-container__required-game" onmouseout="UiToolkitAPI.HideTextTooltip();">
                        <Image class="map-info-container__required-game__game-icon" src="file://{images}/game-logos/css.png" />
                        <Image class="map-info-container__required-game__warning" src="file://{images}/alert.svg" textureheight="48" />
                    </Panel>
                    <Panel id="CSGO" class="map-info-container__required-game" onmouseout="UiToolkitAPI.HideTextTooltip();">
                        <Image class="map-info-container__required-game__game-icon" src="file://{images}/game-logos/csgo.png" />
                        <Image class="map-info-container__required-game__warning" src="file://{images}/alert.svg" textureheight="48" />
                    </Panel>
                    <Panel id="TF2" class="map-info-container__required-game" onmouseout="UiToolkitAPI.HideTextTooltip();">
                        <Image class="map-info-container__required-game__game-icon" src="file://{images}/game-logos/tf2.png" />
                        <Image class="map-info-container__required-game__warning" src="file://{images}/alert.svg" textureheight="48" />
                    </Panel>
                    <Panel id="Portal2" class="map-info-container__required-game" onmouseout="UiToolkitAPI.HideTextTooltip();">
                        <Image class="map-info-container__required-game__game-icon" src="file://{images}/game-logos/portal2.png" />
                        <Image class="map-info-container__required-game__warning" src="file://{images}/alert.svg" textureheight="48" />
                    </Panel>
                </Panel>
            </Panel>
        </Panel>
    </MapInfo>
</root>