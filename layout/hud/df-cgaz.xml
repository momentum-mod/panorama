<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/hud/df-cgaz.ts" />
	</scripts>

	<MomHudDFCgaz class="w-full h-full" hittest="false">
		<ConVarEnabler id="CgazContainer" class="dfhud__strip" convar="mom_hud_df_cgaz_enable" togglevisibility="true">
			<Panel id="LeftTurnZone" />
			<Panel id="LeftFastZone" />
			<Panel id="LeftSlowZone" />
			<Panel id="DeadZone" />
			<Panel id="RightSlowZone" />
			<Panel id="RightFastZone" />
			<Panel id="RightTurnZone" />
			<Panel id="CgazSplitZone" />
			<Panel id="LeftMirrorZone" />
			<Panel id="RightMirrorZone" />
			<Panel id="MirrorSplitZone" />
			<Panel id="WindicatorZone" />
		</ConVarEnabler>
		<Panel id="WindicatorArrow">
			<ConVarEnabler class="h-full" convar="mom_hud_df_windicator_enable" togglevisibility="true">
				<Image id="WindicatorArrowIcon" class="dfhud__arrow dfhud__arrow--down" src="file://{images}/hud/cgaz-arrow.svg" textureheight="48" />
			</ConVarEnabler>
		</Panel>
	</MomHudDFCgaz>
</root>
