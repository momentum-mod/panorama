<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/hud/board-stats.ts" />
	</scripts>

	<MomHudBoardStats class="boardstats">
		<Panel id="BoardStatsContainer" class="boardstats__container">
			<Panel id="BoardStatsMeter" class="boardstats__meter boardstats__meter--hide">
				<Panel id="BoardStatsBar" class="boardstats__bar">
					<Panel id="BoardStatsBarFill" class="boardstats__fill" />
					<Panel id="BoardStatsBestLine" class="boardstats__line boardstats__line--best" />
					<Panel id="BoardStatsAverageLine" class="boardstats__line boardstats__line--average" />
					<Panel id="BoardStatsWindowMarker" class="boardstats__line boardstats__line--window">
						<Panel class="boardstats__dot" />
						<Panel class="boardstats__dot" />
						<Panel class="boardstats__dot" />
						<Panel class="boardstats__dot" />
						<Panel class="boardstats__dot" />
					</Panel>
				</Panel>
				<Panel class="boardstats__labels">
					<Label id="BoardStatsGrade" class="boardstats__label boardstats__label--grade" text="" />
					<Label id="BoardStatsLoss" class="boardstats__label boardstats__label--text" text="#BoardStats_Loss" />
					<Label id="BoardStatsWhy" class="boardstats__label boardstats__label--text" text="" />
					<Label id="BoardStatsRun" class="boardstats__label boardstats__label--text boardstats__label--run" text="#BoardStats_Run" />
				</Panel>
			</Panel>
			<Panel id="BoardStatsTable" class="boardstats__table hide">
				<Panel class="boardstats__table-columns">
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Index" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_index}" class="boardstats__label boardstats__label--text boardstats__column-values" />
					</Panel>
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Grade" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_grade}" class="boardstats__label boardstats__label--text boardstats__column-values" />
					</Panel>
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Loss" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_loss}" class="boardstats__label boardstats__label--text boardstats__column-values" />
					</Panel>
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Angle" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_angle}" class="boardstats__label boardstats__label--text boardstats__column-values" />
					</Panel>
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Split" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_split}" class="boardstats__label boardstats__label--text boardstats__column-values" />
					</Panel>
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Window" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_window}" class="boardstats__label boardstats__label--text boardstats__column-values" />
					</Panel>
					<Panel class="boardstats__column">
						<Label text="#BoardStats_Table_Why" class="boardstats__label boardstats__label--text boardstats__column-name" />
						<Label text="{s:table_why}" class="boardstats__label boardstats__label--text boardstats__column-values boardstats__column-values--left" />
					</Panel>
				</Panel>
				<Label text="#BoardStats_Table_Footer" class="boardstats__label boardstats__label--text boardstats__table-footer" />
			</Panel>
		</Panel>
	</MomHudBoardStats>
</root>
