<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>
	
	<scripts>
		<include type="module" src="file://{scripts}/hud/powerup-timer.ts" />
	</scripts>

	<MomHudPowerupTimer class="powerup-timer">
		<Panel id="HasteTimer" class="powerup-timer__item">
			<Image id="HasteIcon" class="powerup-timer__icon powerup-timer__icon--haste" src="file://{images}/hud/haste-powerup.svg" textureheight="72"/>
			<Label id="HasteLabel" class="powerup-timer__label" text="" />
		</Panel>
		<Panel id="DamageBoostTimer" class="powerup-timer__item">
			<Image id="DamageBoostIcon" class="powerup-timer__icon powerup-timer__icon--damageboost" src="file://{images}/hud/damageboost-powerup.svg" textureheight="72"/>
			<Label id="DamageBoostLabel" class="powerup-timer__label" text="" />
		</Panel>
		<Panel id="SlickTimer" class="powerup-timer__item">
			<Image id="SlickIcon" class="powerup-timer__icon" src="file://{images}/hud/slick-powerup.svg" textureheight="72"/>
			<Label id="SlickLabel" class="powerup-timer__label" text="" />
		</Panel>
		<Panel id="FlightTimer" class="powerup-timer__item">
			<Image id="FlightIcon" class="powerup-timer__icon" src="file://{images}/hud/flight-powerup.svg" textureheight="72"/>
			<Label id="FlightLabel" class="powerup-timer__label" text="" />
		</Panel>
		<Panel id="AirJumpIndicator" class="powerup-timer__item">
			<Image id="AirJumpIcon" class="powerup-timer__icon" src="file://{images}/hud/airjump-powerup.svg" textureheight="72"/>
		</Panel>
	</MomHudPowerupTimer>
</root>
