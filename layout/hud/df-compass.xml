<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/hud/df-compass.ts" />
	</scripts>

	<MomHudDFCompass class="w-full h-full" hittest="false">
		<Panel id="CompassArrow">
			<ConVarEnabler class="h-full" convar="mom_hud_df_compass_mode" togglevisibility="true">
				<Image id="CompassArrowIcon" class="dfhud__arrow dfhud__arrow--up" src="file://{images}/hud/cgaz-arrow.svg" textureheight="48" />
			</ConVarEnabler>
		</Panel>
		<ConVarEnabler class="h-full h-align-center" convar="mom_hud_df_compass_stat_mode" togglevisibility="true">
			<Panel id="StatsBox" class="dfcompass__stats">
				<Label id="PitchStat" class="dfcompass__stat dfcompass__stat--pitch" />
				<Label id="YawStat" class="dfcompass__stat dfcompass__stat--yaw" />
			</Panel>
		</ConVarEnabler>
		<Panel id="CompassTicks" class="dfcompass__ticks" />
	</MomHudDFCompass>
</root>
