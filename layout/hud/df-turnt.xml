<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/hud/df-turnt.ts" />
	</scripts>

	<MomHudDFTurnt class="w-full h-full" hittest="false">
		<ConVarEnabler id="TurntContainer" class="dfhud__strip" convar="mom_hud_df_turnt_enable" togglevisibility="true" />
		<Panel id="TurntArrow">
			<ConVarEnabler class="h-full" convar="mom_hud_df_turnt_arrow_enable" togglevisibility="true">
				<Image id="TurntArrowIcon" class="dfhud__arrow dfhud__arrow--down" src="file://{images}/hud/cgaz-arrow.svg" textureheight="48" />
			</ConVarEnabler>
		</Panel>
	</MomHudDFTurnt>
</root>
