<root>
	<styles>
		<include src="file://{resources}/styles/main.scss" />
	</styles>

	<scripts>
		<include type="module" src="file://{scripts}/modals/popups/hud-customizer-parts.ts" />
	</scripts>

	<Panel class="PopupPanel Hidden w-fit-children" defaultfocus="Button0" popupbackground="blur">
		<Label id="TitleLabel" class="generic-popup__title" allowrawtext="true" text="{s:title}"/>
		<Panel class="generic-popup__message-panel">
			<Label id="MessageLabel" class="generic-popup__message-label" html="true" allowrawtext="true" text="{s:message}"/>
		</Panel>
		<Panel class="flow-right connected-radiobuttons h-align-center">
			<RadioButton id="PositionButton" class="button radiobutton radiobutton--blue" onactivate="HudCustomizerPartsHandler.setParts('position')">
				<Label class="button__text" text="Position" />
			</RadioButton>
			<RadioButton id="StylesButton" class="button radiobutton radiobutton--blue" onactivate="HudCustomizerPartsHandler.setParts('styles')">
				<Label class="button__text" text="Styles" />
			</RadioButton>
			<RadioButton id="BothButton" class="button radiobutton radiobutton--blue" onactivate="HudCustomizerPartsHandler.setParts('both')">
				<Label class="button__text" text="Both" />
			</RadioButton>
		</Panel>
		<Panel class="row h-align-center mt-4 generic-popup__button-row">
			<Button id="OkButton" class="button button--green mr-3" onactivate="HudCustomizerPartsHandler.onOkPressed()">
				<Label id="OkLabel" class="button__text" text="{s:okText}" />
			</Button>
			<Button id="CancelButton" class="button button--red" onactivate="UiToolkitAPI.CloseAllVisiblePopups()">
				<Label class="button__text" text="#Common_Cancel" />
			</Button>
		</Panel>
	</Panel>
</root>
